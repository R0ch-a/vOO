<mxfile host="app.diagrams.net">
  <diagram name="M-DV-01 Diagrama de Componentes" id="skypass-components">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <!-- título -->
        <mxCell id="title" parent="1"
          style="text;html=1;strokeColor=none;fillColor=none;align=center;fontStyle=1;fontSize=16;"
          value="M-DV-01 — Diagrama de Componentes SkyPass" vertex="1">
          <mxGeometry x="350" y="20" width="800" height="30" as="geometry"/>
        </mxCell>

        <!-- ══════════════════════════════════
             SISTEMA BOUNDARY
             ══════════════════════════════════ -->
        <mxCell id="system-boundary" parent="1"
          style="swimlane;startSize=30;fillColor=none;strokeColor=#1F3864;strokeWidth=2;fontStyle=1;fontSize=14;dashed=0;"
          value="SkyPass — Sistema (skypass.jar — Spring Boot 3)" vertex="1">
          <mxGeometry x="40" y="70" width="1300" height="820" as="geometry"/>
        </mxCell>

        <!-- ══════════ M1 — AUTH ══════════ -->
        <mxCell id="m1" parent="system-boundary"
          style="swimlane;startSize=24;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;"
          value="M1 — Auth &amp; DevOps" vertex="1">
          <mxGeometry x="20" y="50" width="280" height="350" as="geometry"/>
        </mxCell>
        <mxCell id="m1-comp" parent="m1"
          style="shape=mxgraph.uml.component;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;"
          value="AuthController" vertex="1">
          <mxGeometry x="60" y="40" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="m1-svc" parent="m1"
          style="shape=mxgraph.uml.component;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;"
          value="AuthService&#xa;JwtService" vertex="1">
          <mxGeometry x="60" y="110" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="m1-repo" parent="m1"
          style="shape=mxgraph.uml.component;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;"
          value="UsuarioRepository&#xa;PassageiroRepository" vertex="1">
          <mxGeometry x="60" y="180" width="160" height="50" as="geometry"/>
        </mxCell>
        <!-- interface fornecida M1 -->
        <mxCell id="m1-iface-out" parent="m1"
          style="shape=mxgraph.uml.interface2;html=1;whiteSpace=wrap;labelPosition=right;align=left;"
          value="POST /api/auth/*" vertex="1">
          <mxGeometry x="220" y="55" width="30" height="30" as="geometry"/>
        </mxCell>
        <!-- dep: ctrl→svc -->
        <mxCell id="d-m1-cs" parent="m1" style="endArrow=open;endFill=0;dashed=1;html=1;endSize=8;" edge="1" source="m1-comp" target="m1-svc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="d-m1-sr" parent="m1" style="endArrow=open;endFill=0;dashed=1;html=1;endSize=8;" edge="1" source="m1-svc" target="m1-repo">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ══════════ M2 — BOOKING ══════════ -->
        <mxCell id="m2" parent="system-boundary"
          style="swimlane;startSize=24;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;"
          value="M2 — Flight Search &amp; Booking" vertex="1">
          <mxGeometry x="320" y="50" width="280" height="350" as="geometry"/>
        </mxCell>
        <mxCell id="m2-comp" parent="m2"
          style="shape=mxgraph.uml.component;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;"
          value="BookingController" vertex="1">
          <mxGeometry x="60" y="40" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="m2-svc" parent="m2"
          style="shape=mxgraph.uml.component;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;"
          value="BookingService&#xa;FlightService&#xa;SeatService" vertex="1">
          <mxGeometry x="60" y="110" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="m2-chain" parent="m2"
          style="shape=mxgraph.uml.component;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=2;"
          value="«Chain of Responsibility»&#xa;ReservaValidator" vertex="1">
          <mxGeometry x="60" y="185" width="160" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="m2-repo" parent="m2"
          style="shape=mxgraph.uml.component;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;"
          value="ReservaRepository&#xa;VooRepository&#xa;AssentoRepository" vertex="1">
          <mxGeometry x="60" y="238" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="m2-iface-out" parent="m2"
          style="shape=mxgraph.uml.interface2;html=1;whiteSpace=wrap;labelPosition=right;align=left;"
          value="POST /api/reservas/*&#xa;GET /api/voos" vertex="1">
          <mxGeometry x="220" y="55" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="d-m2-cs" parent="m2" style="endArrow=open;endFill=0;dashed=1;html=1;endSize=8;" edge="1" source="m2-comp" target="m2-svc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d-m2-sc" parent="m2" style="endArrow=open;endFill=0;dashed=1;html=1;endSize=8;" edge="1" source="m2-svc" target="m2-chain"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d-m2-cr" parent="m2" style="endArrow=open;endFill=0;dashed=1;html=1;endSize=8;" edge="1" source="m2-chain" target="m2-repo"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ══════════ M3 — PAYMENT ══════════ -->
        <mxCell id="m3" parent="system-boundary"
          style="swimlane;startSize=24;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;"
          value="M3 — Payment &amp; Ticket" vertex="1">
          <mxGeometry x="620" y="50" width="280" height="350" as="geometry"/>
        </mxCell>
        <mxCell id="m3-comp" parent="m3"
