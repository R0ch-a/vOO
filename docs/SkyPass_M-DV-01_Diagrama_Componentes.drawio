        </mxCell>
        <mxCell id="d-m7-cs" parent="m7" style="endArrow=open;endFill=0;dashed=1;html=1;endSize=8;" edge="1" source="m7-comp" target="m7-svc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d-m7-sr" parent="m7" style="endArrow=open;endFill=0;dashed=1;html=1;endSize=8;" edge="1" source="m7-svc" target="m7-repo"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ══════════ DEPENDÊNCIAS ENTRE MÓDULOS ══════════ -->
        <!-- M2 depende de M3 (pagamento na reserva) -->
        <mxCell id="dep-m2-m3" parent="system-boundary"
          style="endArrow=open;endFill=0;dashed=1;html=1;endSize=8;strokeColor=#d6b656;fontStyle=2;fontSize=10;"
          value="«usa»" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="600" y="200" as="sourcePoint"/>
            <mxPoint x="620" y="200" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <!-- M3 publica evento → M5 e M7 (Observer) -->
        <mxCell id="dep-m3-m5" parent="system-boundary"
          style="endArrow=open;endFill=0;dashed=1;html=1;endSize=8;strokeColor=#9673a6;fontStyle=2;fontSize=10;"
          value="«event»&#xa;PagamentoEvent" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="660" y="400" as="sourcePoint"/>
            <mxPoint x="160" y="480" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="dep-m3-m7" parent="system-boundary"
