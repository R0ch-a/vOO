          <mxGeometry relative="1" as="geometry">
            <mxPoint x="900" y="400" as="sourcePoint"/>
            <mxPoint x="760" y="480" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <!-- M4 depende de M2 (reserva para checkin) -->
        <mxCell id="dep-m4-m2" parent="system-boundary"
          style="endArrow=open;endFill=0;dashed=1;html=1;endSize=8;strokeColor=#82b366;fontStyle=2;fontSize=10;"
