          <mxGeometry relative="1" as="geometry">
            <mxPoint x="920" y="220" as="sourcePoint"/>
            <mxPoint x="600" y="220" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <!-- M6 depende de M3 (pagamento de bagagem) -->
