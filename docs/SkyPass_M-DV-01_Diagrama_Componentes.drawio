          <mxGeometry x="60" y="40" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="m4-svc" parent="m4"
          style="shape=mxgraph.uml.component;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;"
          value="CheckinService&#xa;BoardingPassService" vertex="1">
          <mxGeometry x="60" y="110" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="m4-repo" parent="m4"
          style="shape=mxgraph.uml.component;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;"
          value="CheckinRepository&#xa;CartaoEmbarqueRepository" vertex="1">
          <mxGeometry x="60" y="180" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="m4-iface-out" parent="m4"
          style="shape=mxgraph.uml.interface2;html=1;whiteSpace=wrap;labelPosition=right;align=left;"
          value="POST /api/checkin/*" vertex="1">
          <mxGeometry x="220" y="55" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="d-m4-cs" parent="m4" style="endArrow=open;endFill=0;dashed=1;html=1;endSize=8;" edge="1" source="m4-comp" target="m4-svc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d-m4-sr" parent="m4" style="endArrow=open;endFill=0;dashed=1;html=1;endSize=8;" edge="1" source="m4-svc" target="m4-repo"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ══════════ M5+M6+M7 — linha inferior ══════════ -->
        <!-- M5 -->
        <mxCell id="m5" parent="system-boundary"
          style="swimlane;startSize=24;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;"
          value="M5 — Miles &amp; Loyalty" vertex="1">
          <mxGeometry x="20" y="430" width="280" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="m5-comp" parent="m5"
          style="shape=mxgraph.uml.component;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;"
          value="MilesController" vertex="1">
          <mxGeometry x="60" y="36" width="160" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="m5-svc" parent="m5"
          style="shape=mxgraph.uml.component;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;"
          value="MilesService&#xa;«Observer» MilhasListener" vertex="1">
          <mxGeometry x="60" y="100" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="m5-repo" parent="m5"
          style="shape=mxgraph.uml.component;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;"
          value="ContaMilhasRepository&#xa;TransacaoMilhasRepository" vertex="1">
          <mxGeometry x="60" y="168" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="d-m5-cs" parent="m5" style="endArrow=open;endFill=0;dashed=1;html=1;endSize=8;" edge="1" source="m5-comp" target="m5-svc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d-m5-sr" parent="m5" style="endArrow=open;endFill=0;dashed=1;html=1;endSize=8;" edge="1" source="m5-svc" target="m5-repo"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- M6 -->
        <mxCell id="m6" parent="system-boundary"
          style="swimlane;startSize=24;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;"
          value="M6 — Ancillaries" vertex="1">
          <mxGeometry x="320" y="430" width="280" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="m6-comp" parent="m6"
          style="shape=mxgraph.uml.component;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;"
          value="AncillaryController" vertex="1">
          <mxGeometry x="60" y="36" width="160" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="m6-svc" parent="m6"
          style="shape=mxgraph.uml.component;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;"
