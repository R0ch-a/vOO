          value="PagamentoRepository&#xa;BilheteRepository" vertex="1">
          <mxGeometry x="60" y="255" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="m3-iface-out" parent="m3"
          style="shape=mxgraph.uml.interface2;html=1;whiteSpace=wrap;labelPosition=right;align=left;"
          value="POST /api/pagamentos/*" vertex="1">
          <mxGeometry x="220" y="55" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="d-m3-cs" parent="m3" style="endArrow=open;endFill=0;dashed=1;html=1;endSize=8;" edge="1" source="m3-comp" target="m3-svc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d-m3-sf" parent="m3" style="endArrow=open;endFill=0;dashed=1;html=1;endSize=8;" edge="1" source="m3-svc" target="m3-factory"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d-m3-fr" parent="m3" style="endArrow=open;endFill=0;dashed=1;html=1;endSize=8;" edge="1" source="m3-factory" target="m3-repo"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ══════════ M4 — CHECKIN ══════════ -->
        <mxCell id="m4" parent="system-boundary"
          style="swimlane;startSize=24;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;"
          value="M4 — Check-in &amp; Seats" vertex="1">
          <mxGeometry x="920" y="50" width="280" height="350" as="geometry"/>
        </mxCell>
        <mxCell id="m4-comp" parent="m4"
          style="shape=mxgraph.uml.component;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;"
