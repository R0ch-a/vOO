        <mxCell id="d-m6-cs" parent="m6" style="endArrow=open;endFill=0;dashed=1;html=1;endSize=8;" edge="1" source="m6-comp" target="m6-svc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d-m6-sr" parent="m6" style="endArrow=open;endFill=0;dashed=1;html=1;endSize=8;" edge="1" source="m6-svc" target="m6-repo"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- M7 -->
        <mxCell id="m7" parent="system-boundary"
          style="swimlane;startSize=24;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;"
          value="M7 — Admin &amp; QA" vertex="1">
          <mxGeometry x="620" y="430" width="280" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="m7-comp" parent="m7"
          style="shape=mxgraph.uml.component;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;"
          value="AdminController&#xa;ReportController" vertex="1">
          <mxGeometry x="60" y="36" width="160" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="m7-svc" parent="m7"
