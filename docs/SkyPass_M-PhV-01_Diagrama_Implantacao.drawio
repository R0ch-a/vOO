<mxfile host="app.diagrams.net">
  <diagram name="M-PhV-01 Diagrama de Implantação" id="skypass-deployment">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <!-- título -->
        <mxCell id="title" parent="1"
          style="text;html=1;strokeColor=none;fillColor=none;align=center;fontStyle=1;fontSize=16;"
          value="M-PhV-01 — Diagrama de Implantação SkyPass" vertex="1">
          <mxGeometry x="300" y="20" width="800" height="30" as="geometry"/>
        </mxCell>

        <!-- ══════════════════════════════════
             NÓ 1: Browser :Cliente
             ══════════════════════════════════ -->
        <mxCell id="node-browser" parent="1"
          style="shape=mxgraph.network.computer;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;"
          value="Browser :Cliente" vertex="1">
          <mxGeometry x="80" y="180" width="80" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="node-browser-lbl" parent="1"
          style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;align=center;"
          value="Chrome / Firefox / Edge&#xa;(375px – 1920px)" vertex="1">
          <mxGeometry x="30" y="270" width="180" height="30" as="geometry"/>
        </mxCell>

        <!-- artefatos no browser -->
        <mxCell id="art-html" parent="1"
          style="shape=mxgraph.uml.artifact;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;"
          value="«artifact»&#xa;index.html&#xa;style.css&#xa;app.js" vertex="1">
          <mxGeometry x="40" y="320" width="140" height="70" as="geometry"/>
        </mxCell>

        <!-- ══════════════════════════════════
             NÓ 2: Railway :Servidor Spring Boot
             ══════════════════════════════════ -->
        <mxCell id="node-railway" parent="1"
          style="swimlane;startSize=36;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;strokeWidth=2;"
          value="«execution environment»&#xa;Railway :Servidor Spring Boot" vertex="1">
          <mxGeometry x="340" y="80" width="440" height="560" as="geometry"/>
        </mxCell>

        <!-- JVM -->
        <mxCell id="node-jvm" parent="node-railway"
          style="swimlane;startSize=28;fillColor=#ffffff;strokeColor=#82b366;fontStyle=1;fontSize=12;"
          value="«device» JVM 17 — Docker Container" vertex="1">
          <mxGeometry x="20" y="50" width="400" height="460" as="geometry"/>
        </mxCell>

        <!-- artefato JAR -->
        <mxCell id="art-jar" parent="node-jvm"
          style="shape=mxgraph.uml.artifact;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;"
          value="«artifact»&#xa;skypass.jar&#xa;(Spring Boot 3.3 Fat JAR)" vertex="1">
          <mxGeometry x="130" y="30" width="180" height="60" as="geometry"/>
        </mxCell>

        <!-- componentes dentro do JAR -->
        <mxCell id="comp-m1" parent="node-jvm"
          style="shape=mxgraph.uml.component;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;"
          value="M1 Auth" vertex="1">
          <mxGeometry x="20" y="120" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="comp-m2" parent="node-jvm"
          style="shape=mxgraph.uml.component;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;"
          value="M2 Booking" vertex="1">
          <mxGeometry x="140" y="120" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="comp-m3" parent="node-jvm"
          style="shape=mxgraph.uml.component;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;"
          value="M3 Payment" vertex="1">
          <mxGeometry x="260" y="120" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="comp-m4" parent="node-jvm"
          style="shape=mxgraph.uml.component;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;"
          value="M4 Checkin" vertex="1">
          <mxGeometry x="20" y="180" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="comp-m5" parent="node-jvm"
          style="shape=mxgraph.uml.component;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;"
          value="M5 Miles" vertex="1">
          <mxGeometry x="140" y="180" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="comp-m6" parent="node-jvm"
          style="shape=mxgraph.uml.component;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;"
          value="M6 Ancillaries" vertex="1">
          <mxGeometry x="260" y="180" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="comp-m7" parent="node-jvm"
          style="shape=mxgraph.uml.component;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;"
          value="M7 Admin/QA" vertex="1">
          <mxGeometry x="140" y="240" width="100" height="40" as="geometry"/>
        </mxCell>

        <!-- artefatos de config -->
        <mxCell id="art-flyway" parent="node-jvm"
          style="shape=mxgraph.uml.artifact;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;"
          value="«artifact»&#xa;Flyway Migrations&#xa;V1...Vn.sql" vertex="1">
          <mxGeometry x="20" y="300" width="130" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="art-swagger" parent="node-jvm"
          style="shape=mxgraph.uml.artifact;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;"
          value="«artifact»&#xa;OpenAPI / Swagger&#xa;/swagger-ui.html" vertex="1">
          <mxGeometry x="170" y="300" width="130" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="art-env" parent="node-jvm"
          style="shape=mxgraph.uml.artifact;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;"
          value="«artifact»&#xa;application.yml&#xa;(.env vars Railway)" vertex="1">
          <mxGeometry x="250" y="390" width="130" height="50" as="geometry"/>
        </mxCell>

        <!-- ══════════════════════════════════
             NÓ 3: Supabase :PostgreSQL
             ══════════════════════════════════ -->
        <mxCell id="node-supabase" parent="1"
          style="swimlane;startSize=36;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=13;strokeWidth=2;"
          value="«execution environment»&#xa;Supabase :PostgreSQL 16" vertex="1">
          <mxGeometry x="340" y="680" width="440" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="art-db" parent="node-supabase"
          style="shape=mxgraph.flowchart.database;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;"
          value="skypass_db&#xa;15 tabelas + 12 ENUMs&#xa;Backup diário automático" vertex="1">
          <mxGeometry x="60" y="50" width="160" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="art-pgbouncer" parent="node-supabase"
          style="shape=mxgraph.uml.component;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;"
          value="PgBouncer&#xa;(Connection Pool)" vertex="1">
          <mxGeometry x="250" y="60" width="150" height="60" as="geometry"/>
        </mxCell>

        <!-- ══════════════════════════════════
             NÓ 4: GitHub :CI/CD
             ══════════════════════════════════ -->
        <mxCell id="node-github" parent="1"
          style="swimlane;startSize=36;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;strokeWidth=2;"
          value="«execution environment»&#xa;GitHub :CI/CD Pipeline" vertex="1">
          <mxGeometry x="860" y="80" width="440" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="art-actions" parent="node-github"
          style="shape=mxgraph.uml.component;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;"
          value="GitHub Actions&#xa;.github/workflows/&#xa;deploy.yml" vertex="1">
          <mxGeometry x="30" y="50" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="art-pipeline" parent="node-github"
          style="shape=mxgraph.uml.artifact;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;"
          value="«pipeline»&#xa;1. mvn test&#xa;2. mvn package&#xa;3. docker build&#xa;4. deploy Railway" vertex="1">
          <mxGeometry x="220" y="50" width="170" height="100" as="geometry"/>
        </mxCell>

        <!-- ══════════════════════════════════
             NÓs EXTERNOS
             ══════════════════════════════════ -->
        <!-- Gateway -->
        <mxCell id="node-gateway" parent="1"
          style="swimlane;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;strokeWidth=2;"
          value="«external system»&#xa;Gateway de Pagamento" vertex="1">
          <mxGeometry x="860" y="400" width="300" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="art-stripe" parent="node-gateway"
          style="shape=mxgraph.uml.component;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;"
          value="Stripe / PagSeguro&#xa;(prod) ou Mock API (dev)" vertex="1">
          <mxGeometry x="40" y="50" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- Email -->
        <mxCell id="node-email" parent="1"
          style="swimlane;startSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;strokeWidth=2;"
          value="«external system»&#xa;Serviço de E-mail" vertex="1">
          <mxGeometry x="860" y="590" width="300" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="art-sendgrid" parent="node-email"
          style="shape=mxgraph.uml.component;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;"
          value="SendGrid / SMTP Gmail&#xa;(JavaMailSender)" vertex="1">
          <mxGeometry x="40" y="50" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- ══════════════════════════════════
             COMUNICAÇÕES / PROTOCOLOS
             ══════════════════════════════════ -->

        <!-- Browser ↔ Railway -->
        <mxCell id="link-browser-railway" parent="1"
          style="endArrow=open;startArrow=open;startFill=0;endFill=0;html=1;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontSize=12;"
          value="HTTPS / TLS 1.3&#xa;(REST API JSON)" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="200" y="220" as="sourcePoint"/>
            <mxPoint x="340" y="300" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Railway ↔ Supabase -->
        <mxCell id="link-railway-db" parent="1"
          style="endArrow=open;startArrow=open;startFill=0;endFill=0;html=1;strokeColor=#b85450;strokeWidth=2;fontStyle=1;fontSize=12;"
          value="JDBC / SSL&#xa;(Hibernate / JPA)" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="640" as="sourcePoint"/>
            <mxPoint x="560" y="680" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Railway → Gateway -->
        <mxCell id="link-railway-gw" parent="1"
          style="endArrow=open;endFill=0;html=1;strokeColor=#d6b656;strokeWidth=2;fontStyle=1;fontSize=11;dashed=1;"
          value="HTTPS REST&#xa;(webhook confirm)" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="780" y="350" as="sourcePoint"/>
            <mxPoint x="860" y="450" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Railway → Email -->
        <mxCell id="link-railway-email" parent="1"
          style="endArrow=open;endFill=0;html=1;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;fontSize=11;dashed=1;"
          value="SMTP / HTTPS&#xa;(async @Async)" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="780" y="450" as="sourcePoint"/>
            <mxPoint x="860" y="640" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- GitHub → Railway (deploy) -->
        <mxCell id="link-github-railway" parent="1"
          style="endArrow=open;endFill=0;html=1;strokeColor=#666666;strokeWidth=2;fontStyle=1;fontSize=11;dashed=1;"
          value="Deploy via&#xa;Railway API" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="860" y="240" as="sourcePoint"/>
            <mxPoint x="780" y="300" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- LEGENDA -->
        <mxCell id="legend-box" parent="1"
          style="swimlane;startSize=24;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;"
          value="Legenda" vertex="1">
          <mxGeometry x="40" y="700" width="270" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="leg-node" parent="legend-box"
          style="shape=mxgraph.network.computer;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;"
          value="" vertex="1">
          <mxGeometry x="14" y="36" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="leg-node-lbl" parent="legend-box"
          style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;align=left;"
          value="Nó de execução" vertex="1">
          <mxGeometry x="52" y="44" width="180" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="leg-artifact" parent="legend-box"
          style="shape=mxgraph.uml.artifact;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;"
          value="«artifact»" vertex="1">
          <mxGeometry x="14" y="80" width="80" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="leg-artifact-lbl" parent="legend-box"
          style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;align=left;"
          value="Artefato implantado" vertex="1">
          <mxGeometry x="102" y="90" width="150" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="leg-comm1" parent="legend-box"
          style="endArrow=open;startArrow=open;startFill=0;endFill=0;html=1;strokeColor=#82b366;strokeWidth=2;"
          value="" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="14" y="138" as="sourcePoint"/>
            <mxPoint x="94" y="138" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="leg-comm1-lbl" parent="legend-box"
          style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;align=left;"
          value="Comunicação bidirecional" vertex="1">
          <mxGeometry x="100" y="128" width="155" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="leg-comm2" parent="legend-box"
          style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#d6b656;strokeWidth=2;"
          value="" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="14" y="166" as="sourcePoint"/>
            <mxPoint x="94" y="166" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="leg-comm2-lbl" parent="legend-box"
          style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;align=left;"
          value="Comunicação com externo" vertex="1">
          <mxGeometry x="100" y="156" width="155" height="20" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
